# Example environment variables for the AI Speech Trainer project.
#
# .env.example is the committed template; .env is your local, git-ignored copy
# with real values. To set up a new machine:
#   1. copy .env.example to .env
#   2. fill in your Qwen (DashScope) API key below
#   3. start the backend:  cd backend && uvicorn main:app --reload
#   4. start the frontend: cd frontend && streamlit run Home.py

QWEN_API_KEY=
