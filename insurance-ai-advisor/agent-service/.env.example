# ============ 应用 ============
# 启动时是否预热（连 Milvus、加载向量/重排模型、编译图）。
# 生产保持 true；本地 `uvicorn --reload` 开发时设 false，改代码不用每次重载模型。
WARMUP_ON_STARTUP=true

# ============ 数据库 ============
BIZ_DB_URL=postgresql+asyncpg://insurance:insurance@localhost:5432/insurance_biz
AGENT_DB_URL=postgresql+asyncpg://insurance:insurance@localhost:5432/insurance_agent
REDIS_URL=redis://localhost:6379/0

# ============ 数据库连接池（第 4 步，一般不用改）============
DB_POOL_SIZE=10              # 常驻连接数
DB_MAX_OVERFLOW=20           # 高峰期允许临时多开的连接数
DB_POOL_TIMEOUT=30           # 借不到连接时的等待秒数
DB_POOL_RECYCLE=1800         # 连接最长存活秒数，超过就回收重建
DB_ECHO=false                # 改 true 会打印所有 SQL，排查问题时用

# ============ 跨域（前端地址，第 12 步前端跑起来后按需调整）============
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ 向量库 ============
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=insurance_clauses

# ============ 向量化（第 8 步）============
EMBEDDING_DEVICE=cpu            # 没有独立显卡就保持 cpu
EMBEDDING_DIM=1024              # Qwen3-Embedding-0.6B 的输出维度，必须和集合维度一致
EMBEDDING_BATCH_SIZE=16

# ============ 条款切分（第 8 步）============
CHUNK_SIZE=500                  # 每个切片的目标字数
CHUNK_OVERLAP=80                # 相邻切片的重叠字数

# ============ 检索（第 9 步）============
RETRIEVAL_TOP_K=20              # 稠密/稀疏每路各召回多少候选
RETRIEVAL_RRF_K=60              # RRF 公式的平滑常数
RETRIEVAL_FINAL_TOP_N=5         # 最终返回条数
RETRIEVAL_RERANK_POOL=6         # 送进重排模型的候选数，CPU 上约 2 秒/条
ENABLE_RERANK=true              # 关掉可显著提速，但 Top-1 命中率会下降
RERANKER_MAX_LENGTH=512

# ============ 大模型（DeepSeek，走 OpenAI 兼容接口）============
DEEPSEEK_API_KEY=sk-在这里填你的Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=60                  # 单次模型调用超时（秒）

# ============ 本地模型路径 ============
# 稠密向量：1024 维，32K 上下文，已确认可用
EMBEDDING_MODEL_PATH=E:/models/Qwen3-Embedding-0.6B
# 重排：bge-reranker-v2-m3，CPU 上约 2 秒/条
RERANKER_MODEL_PATH=E:/models/bge-reranker-v2-m3

# ============ 鉴权 ============
JWT_SECRET=改成你自己的随机字符串
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
